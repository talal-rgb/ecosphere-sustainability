# Terrnix Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains secrets.

# ============================================
# PLATFORM DATABASE
# ============================================
# PostgreSQL is required for authenticated SaaS features. Guest calculators do
# not use this connection. Use a dedicated application role in production and
# a separate migration role for deployments.
DATABASE_URL=postgresql://terrnix_app:REPLACE_WITH_PASSWORD@localhost:5432/terrnix
DATABASE_SSL=require
DATABASE_POOL_MAX=10

# ============================================
# AUTHENTICATION
# ============================================
# Generate a high-entropy value with: openssl rand -base64 32
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Prefer a first-party API subdomain such as https://api.terrnix.com.
BETTER_AUTH_URL=https://api.terrnix.com
AUTH_TRUSTED_ORIGINS=https://terrnix.com,https://www.terrnix.com
AUTH_COOKIE_DOMAIN=terrnix.com

# Social login providers are optional. Each provider is enabled only when both
# its client ID and secret are configured.
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_SECRET
MICROSOFT_CLIENT_ID=REPLACE_WITH_MICROSOFT_ENTRA_CLIENT_ID
MICROSOFT_CLIENT_SECRET=REPLACE_WITH_MICROSOFT_ENTRA_CLIENT_SECRET
MICROSOFT_TENANT_ID=common

# ============================================
# PRIVATE EVIDENCE STORAGE
# ============================================
# S3 or an S3-compatible private bucket. Upload URLs are short-lived and
# single-object; the API never accepts provider, bucket, or object keys from a
# browser. Prefer a dedicated quarantine prefix with no public access.
EVIDENCE_STORAGE_PROVIDER=s3
EVIDENCE_STORAGE_BUCKET=REPLACE_WITH_PRIVATE_BUCKET
EVIDENCE_STORAGE_REGION=eu-west-3
# Optional for R2, MinIO, or another S3-compatible provider.
EVIDENCE_STORAGE_ENDPOINT=
EVIDENCE_STORAGE_FORCE_PATH_STYLE=false
# Optional KMS key. Without it, uploads request AES-256 server-side encryption.
EVIDENCE_STORAGE_KMS_KEY_ID=
EVIDENCE_UPLOAD_URL_SECONDS=600

# Dedicated background-worker role. It must differ from DATABASE_URL and have
# only the grants documented in DEPLOYMENT.md. Never use it for the public API.
DOCUMENT_WORKER_DATABASE_URL=postgresql://terrnix_document_worker:REPLACE_WITH_PASSWORD@localhost:5432/terrnix
DOCUMENT_WORKER_POOL_MAX=2

# ============================================
# BILLING CONTROL PLANE
# ============================================
# Billing synchronization uses a separate least-privilege role. Checkout and
# live payments remain disabled until commercial/legal approval.
BILLING_DATABASE_URL=postgresql://terrnix_billing:REPLACE_WITH_PASSWORD@localhost:5432/terrnix
BILLING_POOL_MAX=2
STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_STRIPE_WEBHOOK_SECRET

# Dedicated report renderer role. Never reuse the API, billing, or document-worker role.
REPORT_WORKER_DATABASE_URL=postgresql://terrnix_report_worker:REPLACE_WITH_PASSWORD@localhost:5432/terrnix
REPORT_WORKER_POOL_MAX=2

# ============================================
# ZOHO SMTP — Email Notifications
# ============================================
# Zoho Mail SMTP settings:
#   Host: smtp.zoho.com (or smtp.zoho.eu for EU accounts)
#   Port: 587 (TLS) or 465 (SSL)
#   User: Your Zoho email address
#   Pass: App-specific password (NOT your account password)
#
# To create an app password:
#   1. Log in to Zoho Mail
#   2. Settings → Security → App-Specific Passwords
#   3. Generate password for "Terrnix Backend"
#   4. Copy the password here

ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=587
ZOHO_SMTP_USER=notifications@terrnix.com
ZOHO_SMTP_PASS=your-app-specific-password-here

# Where contact form submissions and newsletter signups are sent
CONTACT_TO_EMAIL=tallal@terrnix.com

# ============================================
# BREVO — Newsletter / Contact List
# ============================================
# Brevo (formerly Sendinblue) API key:
#   1. Sign up at https://www.brevo.com
#   2. Dashboard → SMTP & API → API Keys
#   3. Generate a v3 API key
#   4. Copy the key here
#
# Brevo List ID:
#   1. Dashboard → Contacts → Lists
#   2. Create a list (e.g. "Terrnix Newsletter")
#   3. Note the List ID number

BREVO_API_KEY=your-brevo-api-key-here
BREVO_LIST_ID=4

# ============================================
# LEAD STORAGE — File-based persistence fallback
# ============================================
# When email or Brevo integrations fail, leads are saved to a local
# JSONL file. This ensures no contact or newsletter signup is lost.
#
# LEADS_FILE_PATH: Absolute or relative path to the JSONL file.
#   Default: ./data/leads.jsonl (relative to backend/)
# LEADS_MAX_SIZE_MB: Maximum file size before rejections.
#   Default: 10

LEADS_FILE_PATH=./data/leads.jsonl
LEADS_MAX_SIZE_MB=10

# ============================================
# ADMIN / DEBUG
# ============================================
# ADMIN_API_TOKEN: Secret token for accessing admin endpoints
#   (e.g. /api/admin/lead-stats). Generate a strong random string.
#   If not set, admin endpoints return 503.

ADMIN_API_TOKEN=generate-a-strong-random-token-here

# ============================================
# OPENAI — Chatbot
# ============================================
OPENAI_API_KEY=sk-proj_REPLACE_WITH_YOUR_KEY
OPENAI_MODEL=gpt-5.4-mini

# ============================================
# CARBON DATA APIs
# ============================================
CLIMATIQ_API_KEY=REPLACE_WITH_CLIMATIQ_KEY
ELECTRICITYMAPS_API_KEY=REPLACE_WITH_ELECTRICITY_MAPS_KEY

# ============================================
# REPORTING
# ============================================
REPORT_BRAND_NAME=Terrnix Sustainability Intelligence
REPORT_CONTACT_EMAIL=info@terrnix.com

# ============================================
# SERVER
# ============================================
PORT=3000
NODE_ENV=production
ALLOWED_ORIGIN=https://terrnix.com
